<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PERMISSIONS: internet, network state, notifications, contacts (read + write for Sync contacts) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Sync adapter: the "VGContact" account that Android's own scheduler uses to wake the sync. -->
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />

    <!-- Android 11+ only lets the app see these packages if listed here (ShareHelper checks whether WhatsApp is installed). -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:name=".VGApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VGContact">

        <!-- Onboarding / Registration Screen. App's launcher activity.
             Uses the dark splash theme ONLY for the moment Android shows
             the launch window; RegisterActivity.onCreate() switches to
             the normal Theme.VGContact before drawing anything, so the
             register screen keeps its own white background. -->
        <activity
            android:name=".RegisterActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:theme="@style/Theme.VGContact.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen banned page (server said the account is banned). -->
        <activity
            android:name=".BannedActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Login: only reached via the "Already have an account?" link -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:screenOrientation="portrait" />

        <!-- One account per phone: shown when sign-up / login is stopped by the device rule -->
        <activity
            android:name=".DeviceBlockedActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- One account per phone: shown when the phone returns no Android ID -->
        <activity
            android:name=".DeviceUnverifiedActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Permissions: shown once after register/login, before Home -->
        <activity
            android:name=".PermissionsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Home Screen -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Repost Screen -->
        <activity
            android:name=".RepostActivity"
            android:exported="false"
            android:screenOrientation="portrait" />



        <!-- Referral Screen: reached from "Refer & Earn" on Home -->
        <activity
            android:name=".ReferralActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:screenOrientation="portrait" />

        <!-- Profile Screen -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Notifications: reached from the header bell icon -->
        <activity
            android:name=".NotificationsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Pay to verify: reached from the pending sheet's Pay button -->
        <activity
            android:name=".PayVerifyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Terms & Conditions / Privacy Policy: reached from the floating help button -->
        <activity
            android:name=".LegalActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Status-bar (small) icon for pushes that Firebase draws itself,
             i.e. when the app is closed or in the background. Without this
             Android falls back to the launcher logo. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/vg_green" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="vgcontact_notifications" />

        <!-- Receives pushes sent by the send-push Supabase Edge Function. -->
        <service
            android:name=".VgFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Sync adapter (extra trigger for the contact sync, admin switch sync_adapter_enabled).
             The account service only lets the "VGContact" account exist; the sync service is what
             Android wakes. See VgSyncAdapter.kt. -->
        <service
            android:name=".VgAccountService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>
        <service
            android:name=".VgSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/syncadapter" />
        </service>

        <!-- Lets other apps (WhatsApp) read the invite image from our cache. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
