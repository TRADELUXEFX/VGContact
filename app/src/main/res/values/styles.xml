<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VGContact" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/vg_green</item>
        <item name="colorPrimaryVariant">@color/vg_green_dark</item>
        <item name="colorSecondary">@color/vg_green</item>
        <item name="colorSecondaryVariant">@color/vg_green_dark</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:statusBarColor">@color/vg_green</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="textAppearanceButton">@style/TextAppearance.VG.Button</item>
    </style>

    <!-- Buttons: bold Poppins (Material buttons ignore the theme font). -->
    <style name="TextAppearance.VG.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="fontFamily">@font/poppins_bold</item>
    </style>

    <!-- Splash theme. Applied ONLY to the launcher activity in the
         manifest, and only affects the window shown while the app
         process starts. RegisterActivity swaps back to Theme.VGContact
         in onCreate() (before setContentView) so this dark color never
         reaches the register screen or any other screen. Change the
         splash color via @color/splash_background and nothing else
         changes. -->
    <style name="Theme.VGContact.Splash" parent="Theme.VGContact">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
    </style>

    <!-- Text Appearance Styles for other Poppins weights -->
    <style name="TextAppearance.Poppins.Medium" parent="android:TextAppearance">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>

    <style name="TextAppearance.Poppins.SemiBold" parent="android:TextAppearance">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="TextAppearance.Poppins.Bold" parent="android:TextAppearance">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="fontFamily">@font/poppins_bold</item>
    </style>

    <!-- Single-font system: Poppins everywhere. Headings use Poppins Bold. -->
    <style name="TextAppearance.Poppins.ExtraBold" parent="android:TextAppearance">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Poppins.BoldHeading" parent="android:TextAppearance">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Button Styles -->
    <style name="ButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/vg_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="ButtonOutlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/vg_green</item>
        <item name="android:textColor">@color/vg_green</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="ButtonDestructive" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/vg_red</item>
        <item name="android:textColor">@color/vg_red</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Card Styles -->
    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Forces a ShapeableImageView to clip to a perfect circle, so a
         square source image (e.g. the launcher icon) never overlaps or
         squares off a circular avatar background. -->
    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>



    <!-- Rounded pop-up (used by the out-of-keys dialog). -->
    <style name="ShapeAppearance.VG.RoundedDialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="VGRoundedAlertDialog" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearance">@style/ShapeAppearance.VG.RoundedDialog</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>

</resources>
