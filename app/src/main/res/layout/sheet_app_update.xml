<?xml version="1.0" encoding="utf-8"?>
<!-- "New version" bottom sheet. Shown by AppUpdatePrompt in a BottomSheetDialog.
     Same look as the pending sheet: green gradient header with see-through circles,
     white "lifted" card on the light background, a lifted green button.
     For a forced update the code hides updateCloseBtn and updateLaterBtn. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/pending_header_background"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-78dp"
                android:layout_marginEnd="-48dp"
                android:importantForAccessibility="no"
                android:src="@drawable/pending_header_bubble" />

            <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="-30dp"
                android:layout_marginBottom="-46dp"
                android:importantForAccessibility="no"
                android:src="@drawable/pending_header_bubble" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:paddingBottom="24dp">

                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/pending_handle_on_green" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/pending_free_pill"
                        android:fontFamily="@font/poppins_semibold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.06"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:text="@string/update_pill"
                        android:textColor="@color/vg_green_dark"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/updateCloseBtn"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/notification_circle_background"
                        android:clickable="true"
                        android:contentDescription="@string/update_close"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_close_small"
                        app:tint="@color/white" />
                </LinearLayout>

                <TextView
                    android:id="@+id/updateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/update_title"
                    android:textColor="@color/white"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/updateSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.9"
                    android:fontFamily="@font/poppins"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="160dp"
                android:layout_height="128dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ill_update" />


            <LinearLayout
                android:id="@+id/updateNotesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/pending_card_lifted"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/pending_step_circle_soft"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_download"
                        app:tint="@color/vg_green_dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:includeFontPadding="false"
                        android:text="@string/update_whats_new"
                        android:textColor="@color/vg_dark"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/updateNotesBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/poppins"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/updateYourVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/updateBtnWrap"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/btn_primary_shadow" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateBtn"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:backgroundTint="@color/vg_green"
                    android:fontFamily="@font/poppins_extrabold"
                    android:includeFontPadding="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0.01"
                    android:stateListAnimator="@null"
                    android:text="@string/update_btn_now"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/white" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/updateLaterBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/white"
                android:fontFamily="@font/poppins_extrabold"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                android:text="@string/update_btn_later"
                android:textAllCaps="false"
                android:textColor="@color/vg_green_dark"
                android:textSize="14sp"
                app:cornerRadius="18dp"
                app:strokeColor="@color/vg_green"
                app:strokeWidth="1.5dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
