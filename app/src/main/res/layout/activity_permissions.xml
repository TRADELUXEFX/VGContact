<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stats_card_fill">

    <!-- ===================== PERMISSION STEP UI ===================== -->
    <LinearLayout
        android:id="@+id/permissionStepContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Green gradient header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingTop="48dp"
            android:paddingBottom="36dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center">

            <TextView
                android:textAppearance="@style/TextAppearance.VG.CaptionSemibold"
                android:id="@+id/stepCounterText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="@color/white"
                android:alpha="0.85"
                tools:text="STEP 1 OF 1" />

            <TextView
                android:textAppearance="@style/TextAppearance.VG.Title"
                android:includeFontPadding="false"
                android:id="@+id/stepTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/white"
                android:gravity="center"
                tools:text="Stay Notified" />

        </LinearLayout>

        <!-- Card content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:gravity="top|center_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/card_background"
                android:padding="28dp">

                <ImageView
                    android:id="@+id/stepIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="200dp"
                    android:maxHeight="200dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/illus_empty_contacts"
                    android:contentDescription="@null" />

                <TextView
                    android:textAppearance="@style/TextAppearance.VG.Body"
                    android:id="@+id/stepDescriptionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    tools:text="Get alerts for new files, reposts and unlocks." />

            </LinearLayout>

        </LinearLayout>
        </ScrollView>

        <!-- Action button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <Button
                android:textAppearance="@style/TextAppearance.VG.Button"
                android:includeFontPadding="false"
                android:id="@+id/stepActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
        android:minHeight="56dp"
                android:maxLines="1"
                android:ellipsize="none"
                android:letterSpacing="0.02"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="11sp"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeStepGranularity="1sp"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                app:cornerRadius="28dp"
                tools:text="Allow Notifications" />

        </LinearLayout>

    </LinearLayout>

    <!-- ===================== LOADING SCREEN ===================== -->
    <LinearLayout
        android:id="@+id/loadingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/white"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/loadingSpinner"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/vg_green" />

        <TextView
            android:textAppearance="@style/TextAppearance.VG.BodySmall"
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/text_muted"
            android:text=""
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
