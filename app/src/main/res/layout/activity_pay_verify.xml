<?xml version="1.0" encoding="utf-8"?>
<!-- Pay to verify screen (PayVerifyActivity). Same look as the pending sheet: green gradient header
     with see-through circles, white "lifted" cards on the light background, a lifted green button.
     Shows the amount and the bank details, then a "Send proof" button that opens WhatsApp to the
     admin with a ready message. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_gradient"
        android:clipChildren="true"
        android:clipToPadding="true">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-78dp"
            android:layout_marginEnd="-48dp"
            android:importantForAccessibility="no"
            android:src="@drawable/pending_header_bubble" />

        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-30dp"
            android:layout_marginBottom="-46dp"
            android:importantForAccessibility="no"
            android:src="@drawable/pending_header_bubble" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="48dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/payBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/buy_header_pill"
                android:clickable="true"
                android:contentDescription="@string/pay_back"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:textAppearance="@style/TextAppearance.VG.Title"
                    android:id="@+id/payHeaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/pay_title"
                    android:textColor="@color/white" />

                <TextView
                    android:textAppearance="@style/TextAppearance.VG.BodySmall"
                    android:id="@+id/payHeaderSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.9"
                    android:includeFontPadding="false"
                    android:text="@string/pay_subtitle"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/payDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/payAmountCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pending_card_lifted"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="22dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:textAppearance="@style/TextAppearance.VG.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/pay_amount_label"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:textAppearance="@style/TextAppearance.VG.Display"
                            android:id="@+id/payAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/vg_green_dark" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/pay_pill_green"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="9dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_pay_shield"
                            app:tint="@color/vg_green_dark" />

                        <TextView
                            android:textAppearance="@style/TextAppearance.VG.BodySemibold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:includeFontPadding="false"
                            android:text="@string/pay_one_time"
                            android:textColor="@color/vg_green_dark" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/payAccountCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/pending_card_lifted"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/pending_step_circle_soft"
                            android:importantForAccessibility="no"
                            android:padding="11dp"
                            android:src="@drawable/ic_pay_bank"
                            app:tint="@color/vg_green_dark" />

                        <TextView
                            android:textAppearance="@style/TextAppearance.VG.Subheading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:includeFontPadding="false"
                            android:text="@string/pay_send_to"
                            android:textColor="@color/vg_dark" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:textAppearance="@style/TextAppearance.VG.BodySmall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:includeFontPadding="false"
                            android:text="@string/pay_bank"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:textAppearance="@style/TextAppearance.VG.Subheading"
                            android:id="@+id/payBankName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textColor="@color/vg_dark" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:textAppearance="@style/TextAppearance.VG.BodySmall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:includeFontPadding="false"
                            android:text="@string/pay_account_name"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:textAppearance="@style/TextAppearance.VG.Subheading"
                            android:id="@+id/payAccountName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textColor="@color/vg_dark" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/card_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:textAppearance="@style/TextAppearance.VG.BodySmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/pay_account_number"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:textAppearance="@style/TextAppearance.VG.Title"
                                android:id="@+id/payAccountNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:includeFontPadding="false"
                                android:textColor="@color/vg_dark"
                                android:textIsSelectable="true" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/payCopyAccount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/pay_pill_green"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="8dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_copy"
                                app:tint="@color/vg_green_dark" />

                            <TextView
                                android:textAppearance="@style/TextAppearance.VG.BodySmallSemibold"
                                android:id="@+id/payCopyAccountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:includeFontPadding="false"
                                android:text="@string/pay_copy"
                                android:textColor="@color/vg_green_dark" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:textAppearance="@style/TextAppearance.VG.BodySmall"
                        android:id="@+id/payDetailsMissing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/pay_details_missing"
                        android:textColor="@color/vg_red_dark"
                        android:visibility="gone" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/payProofWrap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
        android:minHeight="58dp"
                    android:layout_marginTop="18dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/btn_primary_shadow" />

                    <com.google.android.material.button.MaterialButton
                        android:textAppearance="@style/TextAppearance.VG.Button"
                        android:id="@+id/payProofBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
        android:minHeight="54dp"
                        android:backgroundTint="@color/vg_green"
                        android:includeFontPadding="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:letterSpacing="0.01"
                        android:stateListAnimator="@null"
                        android:text="@string/pay_btn_proof"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_pending_whatsapp"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconSize="22dp"
                        app:iconTint="@color/white" />
                </FrameLayout>

                <TextView
                    android:textAppearance="@style/TextAppearance.VG.BodySmall"
                    android:id="@+id/payNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:padding="6dp"
                    android:text="@string/pay_note"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
