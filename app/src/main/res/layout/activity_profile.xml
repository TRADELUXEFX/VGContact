<?xml version="1.0" encoding="utf-8"?>
<!--
    Root is a FrameLayout so the bottom nav bar can float over the
    content as a rounded pill (see bottom_nav_bar.xml) instead of
    sitting in-flow as a full-width bar. Structure matches VGKontact's
    activity_profile.xml: gradient header, then a card of label-above-
    value rows separated by thin dividers.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/header_gradient"
        android:paddingTop="40dp"
        android:paddingBottom="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center">

        <TextView
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:textSize="24sp"
            android:textColor="@color/white" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="140dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp">

            <!-- Username -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="USERNAME"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="@color/text_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/profile_email"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/vg_dark" />

                <LinearLayout
                    android:id="@+id/profileUsernameCopyIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/badge_verified_background"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:contentDescription="Copy username"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/vg_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Copy"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/vg_green" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/stats_card_border"
                android:layout_marginBottom="16dp" />

            <!-- Phone Number -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PHONE NUMBER"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="@color/text_muted" />

            <TextView
                android:id="@+id/profile_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/vg_dark"
                android:paddingBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/stats_card_border"
                android:layout_marginBottom="16dp" />

            <!-- Referred By -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="REFERRED BY"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="@color/text_muted" />

            <TextView
                android:id="@+id/profile_referred_by"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/vg_dark"
                android:paddingBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/stats_card_border"
                android:layout_marginBottom="16dp" />

            <!-- Date Registered -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DATE REGISTERED"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="@color/text_muted" />

            <TextView
                android:id="@+id/profile_created"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/vg_dark"
                android:paddingBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/stats_card_border"
                android:layout_marginBottom="16dp" />

            <!-- App Version -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="APP VERSION"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="@color/text_muted" />

            <TextView
                android:id="@+id/profile_app_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/vg_dark"
                android:paddingBottom="16dp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false"
            android:textSize="16sp"
            android:id="@+id/sync_frequency_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Sync every 24 hours"
            android:textAllCaps="false"
            android:textColor="@color/vg_green"
            app:icon="@drawable/ic_history"
            app:iconTint="@color/vg_green"
            app:iconGravity="textStart"
            app:strokeColor="@color/vg_green"
            app:strokeWidth="1.5dp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false"
            android:textSize="16sp"
            android:id="@+id/delete_contacts_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Delete My Contacts"
            android:textAllCaps="false"
            android:textColor="@color/vg_red"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/vg_red"
            app:iconGravity="textStart"
            app:strokeColor="@color/vg_red"
            app:strokeWidth="1.5dp"
            app:cornerRadius="16dp" />

    </LinearLayout>

    </ScrollView>

</LinearLayout>

    <include layout="@layout/bottom_nav_bar" />

</FrameLayout>
