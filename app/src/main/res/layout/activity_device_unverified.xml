<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Whole screen scrolls: on small phones or large font sizes nothing is squeezed
         or hidden between the header and the buttons. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- GREEN HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/header_gradient"
            android:paddingTop="56dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="32dp">

            <TextView
                android:textAppearance="@style/TextAppearance.VG.Lead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="We couldn't verify"
                android:alpha="0.92"
                android:gravity="center"
                android:textColor="@color/white" />

            <TextView
                android:textAppearance="@style/TextAppearance.VG.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This Phone"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- WHITE BODY -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
            android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

            <TextView
                android:textAppearance="@style/TextAppearance.VG.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="We couldn't generate a verification code for this phone. Try again, or contact customer care for help."
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginTop="16dp" />
            </LinearLayout>

        <!-- BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.button.MaterialButton
                android:textAppearance="@style/TextAppearance.VG.Button"
                android:id="@+id/tryAgainButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
        android:minHeight="56dp"
                android:includeFontPadding="false"
                android:text="Try again"
                android:textAllCaps="false"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp"
                app:cornerRadius="16dp" />
            <com.google.android.material.button.MaterialButton
                android:textAppearance="@style/TextAppearance.VG.Button"
                android:id="@+id/contactCareButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
        android:minHeight="56dp"
                android:includeFontPadding="false"
                android:text="Contact customer care"
                android:textAllCaps="false"
                android:textColor="@color/vg_green_dark"
                app:strokeColor="@color/vg_green"
                app:strokeWidth="1.5dp"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="16dp" />
        </LinearLayout>

    </LinearLayout>
    </ScrollView>

</FrameLayout>
