<?xml version="1.0" encoding="utf-8"?>
<!--
    Shown for the brief moment while SplashActivity checks whether this
    device already has a session (SessionManager.isLoggedIn()) and
    decides whether to route to HomeActivity or RegisterActivity. Dark
    background with a centered green spinner, per the app's existing
    loading-state pattern (see PermissionsActivity's loadingContainer)
    rather than introducing a new visual style.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/vg_dark">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@null" />

</LinearLayout>
