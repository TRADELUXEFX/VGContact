<?xml version="1.0" encoding="utf-8"?>
<!--
    A single notification row: unread dot, title, body, relative time.
    The dot is only visible while the item is unread (all items get
    marked read as soon as the screen opens, so this reflects state
    at load time, not live).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_background"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <View
        android:id="@+id/notification_unread_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/notification_unread_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/vg_dark" />

        <TextView
            android:id="@+id/notification_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="12.5sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/notification_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="10.5sp"
            android:textColor="@color/text_muted" />

    </LinearLayout>

</LinearLayout>
