<?xml version="1.0" encoding="utf-8"?>
<!-- Buy Keys paywall. Reached from the "Get more" button on Home and from
     Downloads when a group can't be unlocked. Full-bleed brand green, no
     bottom nav; the buy button is pinned to the bottom. Buying only;
     earning keys by reposting lives on the Repost tab. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vg_green_dark">

    <!-- All screen content. Starts invisible and is revealed by
         BuyKeysActivity only once the key balance has loaded, so the
         user never sees a half-empty screen fill in piece by piece. -->
    <LinearLayout
        android:id="@+id/buy_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="invisible">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp">

                <!-- [Back] [Title ........] [balance]. Same Back + title look
                     as every other screen (see layout_back_header.xml); the
                     key-balance pill is pinned to the far right. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/back_header_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/buy_header_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_medium"
                        android:includeFontPadding="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Back"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/back_header_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/baloo_2_extrabold"
                        android:gravity="start|center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/buy_key_balance_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/buy_header_pill"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text=""
                        android:textSize="14sp"
                        android:textColor="@color/vg_green_tint" />

                </LinearLayout>

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/buy_keys_tile_logo"
                    android:contentDescription="VGContact" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Get More Status\nViewers With VGContact"
                    android:fontFamily="@font/baloo_2_extrabold"
                    android:includeFontPadding="false"
                    android:textSize="32sp"
                    android:textColor="@color/white"
                    android:maxLines="2"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="24sp"
                    app:autoSizeMaxTextSize="34sp"
                    app:autoSizeStepGranularity="1sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="1 KEY UNLOCKS 250 STATUS VIEWERS"
                    android:textSize="14sp"
                    android:textColor="@color/vg_green_tint"
                    android:gravity="start"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeStepGranularity="1sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/buy_pack_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="18dp"
                    android:background="@drawable/buy_pack_unselected"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 key"
                            android:fontFamily="@font/baloo_2_bold"
                            android:includeFontPadding="false"
                            android:textSize="20sp"
                            android:textColor="@color/vg_dark" />

                        <TextView
                            android:id="@+id/buy_pack_1_viewers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            tools:text="250 status viewers" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₦1,000"
                        android:fontFamily="@font/baloo_2_extrabold"
                        android:includeFontPadding="false"
                        android:textSize="22sp"
                        android:textColor="@color/vg_green_dark" />

                </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp">

                <LinearLayout
                    android:id="@+id/buy_pack_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="18dp"
                    android:background="@drawable/buy_pack_selected"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 keys"
                            android:fontFamily="@font/baloo_2_bold"
                            android:includeFontPadding="false"
                            android:textSize="20sp"
                            android:textColor="@color/vg_dark" />

                        <TextView
                            android:id="@+id/buy_pack_5_viewers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            tools:text="1,250 status viewers" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₦5,000"
                        android:fontFamily="@font/baloo_2_extrabold"
                        android:includeFontPadding="false"
                        android:textSize="22sp"
                        android:textColor="@color/vg_green_dark" />

                </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_marginStart="16dp"
                            android:background="@drawable/buy_badge_background"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="MOST POPULAR"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_dark" />

                    </FrameLayout>

                <LinearLayout
                    android:id="@+id/buy_pack_10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="18dp"
                    android:background="@drawable/buy_pack_unselected"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10 keys"
                            android:fontFamily="@font/baloo_2_bold"
                            android:includeFontPadding="false"
                            android:textSize="20sp"
                            android:textColor="@color/vg_dark" />

                        <TextView
                            android:id="@+id/buy_pack_10_viewers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            tools:text="2,500 status viewers" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₦8,000"
                        android:fontFamily="@font/baloo_2_extrabold"
                        android:includeFontPadding="false"
                        android:textSize="22sp"
                        android:textColor="@color/vg_green_dark" />

                </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buy_keys_whatsapp_btn"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="Get 5 keys"
                android:textAllCaps="false"
                android:fontFamily="@font/baloo_2_bold"
                android:textSize="19sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/vg_dark"
                app:cornerRadius="29dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Shown first (default), hidden once the content is ready. -->
    <FrameLayout
        android:id="@+id/buy_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vg_green_dark"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/white" />

    </FrameLayout>

</FrameLayout>
