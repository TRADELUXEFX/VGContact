<?xml version="1.0" encoding="utf-8"?>
<!--
    Root is a FrameLayout so the bottom nav bar can float over the
    scrollable content as a rounded pill (see bottom_nav_bar.xml).
    Structure matches VGKontact's activity_main_menu.xml: gradient
    header with circular avatar + badge + referral row, then a body
    with a stats card and action buttons below.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_content_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= HEADER ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingTop="48dp"
            android:paddingBottom="18dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/headerProfileIcon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:padding="0dp"
                        android:src="@mipmap/ic_launcher_round"
                        android:background="@drawable/avatar_circle_background"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:id="@+id/headerUsernameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:letterSpacing="0.01"
                        android:textColor="@color/white"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/group_badge_background"
                        android:paddingStart="8dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/badge_dot" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VERIFIED"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.04"
                            android:textColor="@color/white" />

                    </LinearLayout>

                </LinearLayout>

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp">

                    <ImageView
                        android:id="@+id/headerBellIcon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_notification_bell"
                        android:background="@drawable/notification_circle_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Notifications"
                        app:tint="@color/white" />

                    <View
                        android:id="@+id/headerBellUnreadDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/notification_unread_dot"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

            <!-- Referral code row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/header_tab_track_background"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/headerPhoneText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <Button
                    android:id="@+id/headerCopyBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Copy"
                    android:textAllCaps="false"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/vg_green_dark"
                    android:backgroundTint="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ================= BODY ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <!-- First-time intro, shown once (dismissed with "Got it") -->
            <LinearLayout
                android:id="@+id/home_intro_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/card_background"
                android:visibility="gone">

                <TextView
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How VGContact works"
                    android:textSize="18sp"
                    android:textColor="@color/vg_dark" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="6dp"
                    android:text="1   Get a key. Repost for free, or buy one for ₦1,000.\n2   Unlock a contact file. 1 key unlocks 1 file.\n3   Download it and save the contacts."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Keys are added within 24 hours."
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />

                <com.google.android.material.button.MaterialButton
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:textSize="16sp"
                    android:id="@+id/home_intro_got_it"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="Got it"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/vg_green"
                    app:cornerRadius="22dp" />

            </LinearLayout>

            <!-- TODAY: repost banner, first container on Home, above the keys card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/text_muted" />

            <LinearLayout
                android:id="@+id/today_repost_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/today_banner_background"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_repost"
                    app:tint="@color/warning_amber"
                    android:contentDescription="@null" />

                <TextView
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Repost to earn today's key"
                    android:textSize="17sp"
                    android:textColor="@color/vg_dark" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_muted"
                    android:contentDescription="@null" />

            </LinearLayout>

            <!-- Keys card. The spinner lives INSIDE
                 the card: while the balance loads, the contents stay
                 invisible (they keep their space so the card never
                 resizes) and the spinner is centered in the card. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_background">

                <ProgressBar
                    android:id="@+id/home_card_loading"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/vg_green"
                    android:visibility="visible" />

                <LinearLayout
                    android:id="@+id/home_card_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:visibility="invisible">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/file_row_icon_background">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_key"
                            app:tint="@color/vg_green_dark"
                            android:contentDescription="@null" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:fontFamily="@font/poppins_bold"
                            android:includeFontPadding="false"
                            android:id="@+id/home_key_balance_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="30sp"
                            android:textColor="@color/vg_green_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your keys"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                    <!-- Opens BuyKeysActivity (buy keys only). Earning keys
                         by reposting lives on the Repost tab. -->
                    <com.google.android.material.button.MaterialButton
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:textSize="16sp"
                        android:id="@+id/get_more_keys_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="Buy Keys"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/vg_green"
                        app:cornerRadius="22dp" />

                </LinearLayout>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="4dp"
                android:text="1 key unlocks 1 contact file"
                android:textSize="12sp"
                android:textColor="@color/text_muted" />

            <!-- Single entry point into the unlock flow. No file preview,
                 no contact counts here - just the action. The real list,
                 lock state per file, and the spend-a-key confirmation all
                 live in DownloadsActivity (see confirmUnlock/unlockWithKey
                 in DownloadsActivity.kt), which this opens directly. -->
            <com.google.android.material.button.MaterialButton
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:textSize="16sp"
                android:id="@+id/unlock_contact_list_btn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:text="Unlock Contact List"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:backgroundTint="@color/vg_green"
                app:icon="@drawable/ic_unlock"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

        </LinearLayout>

        <!-- ================= ACTIONS ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="26dp">

            <!-- Refer & Earn: opens the Referral page (code, link, how it
                 works, share). -->
            <com.google.android.material.button.MaterialButton
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:textSize="16sp"
                android:id="@+id/refer_earn_btn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="Refer &amp; Earn"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:backgroundTint="@color/vg_green"
                app:cornerRadius="16dp" />

            <Button
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:textSize="16sp"
                android:id="@+id/join_community_btn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Join Our Community"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/vg_green_dark"
                android:textColor="@color/vg_green_dark"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/bottom_nav_bar" />

</FrameLayout>
