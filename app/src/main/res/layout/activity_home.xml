<?xml version="1.0" encoding="utf-8"?>
<!--
    Home. VGKontact structure: gradient header, one card holding the
    viewers block (Free / Extra / Referral) and the Sync contacts
    button, then the Buy status viewers button. Root is a FrameLayout so
    the floating nav pill sits over the scrolling content.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_content_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingTop="48dp"
            android:paddingBottom="18dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/headerProfileIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@mipmap/ic_launcher_round"
                android:background="@drawable/avatar_circle_background"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Profile"
                android:foreground="?android:attr/selectableItemBackgroundBorderless" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/headerUsernameText"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/group_badge_background"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/badge_dot" />

                    <TextView
                        android:id="@+id/statusBadgeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PENDING"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.04"
                        android:textColor="@color/white" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <ImageView
                    android:id="@+id/headerBellIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_notification_bell"
                    android:background="@drawable/notification_circle_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Notifications"
                    app:tint="@color/white" />

                <View
                    android:id="@+id/headerBellUnreadDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/notification_unread_dot"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Referral link, inside the green card: a see-through bordered box
             with the label on top and the link below (slides sideways so the
             whole link can be read), white Copy button on the right. -->
        <LinearLayout
            android:id="@+id/home_referral_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/header_referral_container_background"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your referral link"
                    android:fontFamily="@font/poppins"
                    android:includeFontPadding="false"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:alpha="0.85" />

                <HorizontalScrollView
                    android:id="@+id/home_referral_link_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <TextView
                        android:id="@+id/home_referral_link_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:includeFontPadding="false"
                        android:textSize="13sp"
                        android:textColor="@color/white"
                        android:singleLine="true" />

                </HorizontalScrollView>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_referral_copy_btn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:text="Copy"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/vg_green_dark"
                android:backgroundTint="@color/white"
                app:cornerRadius="10dp" />

        </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <!-- Red "update available" card. Stays on Home until the user installs the new version,
                 even after "Maybe later" on the pop-up. Driven by AppUpdatePrompt. -->
            <LinearLayout
                android:id="@+id/updateBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:padding="14dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/update_banner_background"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/banner_icon_circle"
                    android:padding="10dp"
                    android:src="@drawable/ic_download"
                    app:tint="@color/white"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/update_banner_title"
                        android:textSize="14sp"
                        android:textColor="@color/white" />

                    <TextView
                        android:fontFamily="@font/poppins"
                        android:includeFontPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/update_banner_sub"
                        android:textSize="12sp"
                        android:textColor="#E6FFFFFF" />
                </LinearLayout>

                <TextView
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/banner_pill_white"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/update_banner_action"
                    android:textSize="13sp"
                    android:textColor="@color/vg_red_dark" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pendingBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/pending_banner_background"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/banner_icon_circle"
                    android:padding="10dp"
                    android:src="@drawable/ic_pending"
                    app:tint="@color/white"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Account pending"
                        android:textSize="14sp"
                        android:textColor="@color/white" />

                    <TextView
                        android:fontFamily="@font/poppins"
                        android:includeFontPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Verify to unlock the app"
                        android:textSize="12sp"
                        android:textColor="#E6FFFFFF" />
                </LinearLayout>

                <TextView
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/banner_pill_white"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="VERIFY"
                    android:textSize="13sp"
                    android:textColor="#8A5A00" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/permissionBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/permission_banner_background"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_notification_bell"
                    app:tint="@color/white"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/permissionBannerText"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:textSize="14sp"
                    android:textColor="@color/white" />

                <TextView
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FIX"
                    android:textSize="14sp"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- Community banner. No close button: it stays until the user taps it and joins
                 (CommunityLink.hasJoined). A new community_link makes it show again. -->
            <LinearLayout
                android:id="@+id/communityBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/pending_banner_background"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/banner_icon_circle"
                    android:padding="10dp"
                    android:src="@drawable/ic_pending_whatsapp"
                    app:tint="@color/white"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Join our community"
                        android:textSize="14sp"
                        android:textColor="@color/white" />

                    <TextView
                        android:fontFamily="@font/poppins"
                        android:includeFontPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Updates, tips and help from other members."
                        android:textSize="12sp"
                        android:textColor="#E6FFFFFF" />
                </LinearLayout>

                <TextView
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/banner_pill_white"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="JOIN"
                    android:textSize="13sp"
                    android:textColor="#8A5A00" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/waitingBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/pending_banner_background"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/banner_icon_circle"
                    android:padding="10dp"
                    android:src="@drawable/ic_people"
                    app:tint="@color/white"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/waitingBannerTitle"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/waitingBannerText"
                        android:fontFamily="@font/poppins"
                        android:includeFontPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textSize="12sp"
                        android:textColor="#E6FFFFFF" />
                </LinearLayout>

                <TextView
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/banner_pill_white"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="SAVE"
                    android:textSize="13sp"
                    android:textColor="#8A5A00" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_contacts_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/home_limits_loading"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@drawable/limit_block_background"
                    android:visibility="visible">

                    <ProgressBar
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/vg_green" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/home_limits_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/limit_block_background"
                    android:padding="18dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/home_contacts_label"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05"
                            android:textColor="@color/text_muted"
                            android:gravity="start" />

                        <!-- Last sync status: sync icon + time. Text, colors and
                             state are set in HomeActivity.refreshLastSync(). -->
                        <TextView
                            android:id="@+id/lastSyncPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/last_sync_pill_background"
                            android:drawableStart="@drawable/ic_sync_small"
                            android:drawablePadding="5dp"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:text="Not synced yet" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="14dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/viewers_dot_green" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_free_viewers"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/freeViewersCurrentText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:includeFontPadding="false"
                            android:textSize="15sp"
                            android:textColor="@color/vg_dark"
                            android:text="0" />

                        <TextView
                            android:id="@+id/freeViewersMaxText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:includeFontPadding="false"
                            android:textSize="13sp"
                            android:textColor="@color/text_muted"
                            android:text="/0" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/card_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="0dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/viewers_dot_blue" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_extra_viewers"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/extraViewersCurrentText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:includeFontPadding="false"
                            android:textSize="15sp"
                            android:textColor="@color/vg_dark"
                            android:text="0" />

                        <TextView
                            android:id="@+id/extraViewersMaxText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:includeFontPadding="false"
                            android:textSize="13sp"
                            android:textColor="@color/text_muted"
                            android:text="/0" />
                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/card_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="0dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/viewers_dot_amber" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_referral_viewers"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/referralViewersCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:includeFontPadding="false"
                            android:textSize="15sp"
                            android:textColor="@color/vg_dark"
                            android:text="0" />

                    </LinearLayout>


                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/syncContactsBtn"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:textSize="16sp"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/btn_sync_contacts"
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/vg_green"
                    app:icon="@drawable/ic_sync"
                    app:iconTint="@color/white"
                    app:iconGravity="textStart"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="26dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buyViewersBtn"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:textSize="16sp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="@string/btn_buy_viewers"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:textColor="@color/white"
                android:backgroundTint="@color/vg_green"
                app:icon="@drawable/ic_viewers"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/join_community_btn"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:textSize="16sp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Join Our Community"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/vg_green_dark"
                android:textColor="@color/vg_green_dark"
                app:icon="@drawable/ic_pending_whatsapp"
                app:iconTint="@color/vg_green_dark"
                app:iconGravity="textStart"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/bottom_nav_bar" />

    <!-- Full-screen maintenance cover. Shown by MaintenanceNotice while Maintenance mode is on.
         The high elevation puts it above the nav pill (10dp) and the floating chat button (12dp),
         so it truly covers the whole screen and eats all touches. No horizontal padding on this
         root and on the scroll area, so the caution tape can run edge to edge; side padding lives
         on the content blocks instead. -->
    <LinearLayout
        android:id="@+id/maintenanceOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vg_green"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="100dp"
        android:focusable="true"
        android:orientation="vertical"
        android:translationZ="100dp"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:minHeight="0dp"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="16dp">

                <FrameLayout
                    android:layout_width="300dp"
                    android:layout_height="290dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:layout_width="300dp"
                        android:layout_height="290dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/maintenance_illustration" />

                    <FrameLayout
                        android:layout_width="800dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="120dp"
                        android:rotation="-9">

                        <ImageView
                            android:layout_width="800dp"
                            android:layout_height="34dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/maintenance_tape" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:background="#F5B83D"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.1"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="MAINTENANCE"
                            android:textColor="#2C2C2A"
                            android:textSize="12sp" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="We're doing maintenance"
                    android:textColor="@android:color/white"
                    android:textSize="22sp" />

                <LinearLayout
                    android:id="@+id/maintenanceMsgCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/maintenance_message_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:id="@+id/maintenanceOverlayMsg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:gravity="center"
                        android:textColor="@color/vg_dark"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Bottom block: always pinned to the bottom, same side margins as the card above. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/maintenanceCommunityBtn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.02"
                android:text="Join Our Community"
                android:textAllCaps="true"
                android:textColor="@color/vg_green_dark"
                android:textSize="16sp"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_pending_whatsapp"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/vg_green_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/maintenance_pill_background"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="Your saved contacts are safe"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
