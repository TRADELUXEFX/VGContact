<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Whole screen scrolls: on small phones or large font sizes nothing is squeezed
         or hidden between the header and the buttons. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- GREEN HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/header_gradient"
            android:paddingTop="56dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="32dp">

            <TextView android:textAppearance="@style/TextAppearance.VG.Lead" android:id="@+id/headerLineOne"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This phone already has an"
                android:alpha="0.92"
                android:gravity="center"
                android:textColor="@color/white" />

            <TextView android:textAppearance="@style/TextAppearance.VG.Title" android:id="@+id/headerLineTwo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- WHITE BODY -->

            <LinearLayout
                android:id="@+id/accountCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
            android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:textAppearance="@style/TextAppearance.VG.MicroSemibold"
                    android:id="@+id/accountLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR ACCOUNT"
                    android:letterSpacing="0.05"
                    android:textColor="@color/text_muted"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:textAppearance="@style/TextAppearance.VG.Heading"
                    android:id="@+id/accountNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/vg_dark"
                    android:gravity="center" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:textAppearance="@style/TextAppearance.VG.MicroSemibold"
                    android:id="@+id/registeredNumberLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REGISTERED NUMBER"
                    android:letterSpacing="0.05"
                    android:textColor="@color/text_muted"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:textAppearance="@style/TextAppearance.VG.Heading"
                    android:id="@+id/registeredNumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/vg_dark"
                    android:gravity="center" />
            </LinearLayout>
            <TextView
                android:textAppearance="@style/TextAppearance.VG.BodySmall"
                android:id="@+id/bodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Only one account is allowed per phone."
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginTop="16dp" />
            <LinearLayout
                android:id="@+id/newDeviceIdCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:textAppearance="@style/TextAppearance.VG.MicroSemibold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VERIFICATION CODE"
                    android:letterSpacing="0.05"
                    android:textColor="@color/text_muted"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:textAppearance="@style/TextAppearance.VG.Subheading"
                    android:id="@+id/newDeviceIdText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/vg_dark"
                    android:gravity="center" />

                <TextView
                    android:textAppearance="@style/TextAppearance.VG.Caption"
                    android:id="@+id/copyDeviceIdText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to copy"
                    android:textColor="@color/vg_green_dark"
                    android:layout_marginTop="6dp"
                    android:padding="4dp" />
            </LinearLayout>
            </LinearLayout>

        <!-- BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.button.MaterialButton
                android:textAppearance="@style/TextAppearance.VG.Button"
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
        android:minHeight="56dp"
                android:includeFontPadding="false"
                android:text="Log in"
                android:textAllCaps="false"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp"
                app:cornerRadius="16dp" />
            <com.google.android.material.button.MaterialButton
                android:textAppearance="@style/TextAppearance.VG.Button"
                android:id="@+id/contactCareButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
        android:minHeight="56dp"
                android:includeFontPadding="false"
                android:text="Contact customer care"
                android:textAllCaps="false"
                android:textColor="@color/vg_green_dark"
                app:strokeColor="@color/vg_green"
                app:strokeWidth="1.5dp"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="16dp" />
        </LinearLayout>

    </LinearLayout>
    </ScrollView>

</FrameLayout>
