<?xml version="1.0" encoding="utf-8"?>
<!-- Shared screen for Terms & Conditions and Privacy Policy.
     LegalActivity fills in the title and body from an intent extra. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Gradient bar; the Back pill + title come from the shared header. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_gradient"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <include layout="@layout/layout_back_header" />

    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:textAppearance="@style/TextAppearance.VG.Body"
            android:id="@+id/legal_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/vg_dark" />

    </ScrollView>

</LinearLayout>
