<?xml version="1.0" encoding="utf-8"?>
<!-- Refer and earn. Bottom-nav tab screen laid out like VGKontact's Referrals
     page: green header with the My referrals / Leaderboard switcher and a
     search box, then white bordered cards. My referrals = the code card (kept
     from before) plus the referral list with drill-in (levels 2 and 3);
     Leaderboard = top referrers. Rows and pagers are built in
     ReferralActivity.kt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingTop="48dp"
            android:paddingBottom="22dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center">

            <TextView
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Refer and earn"
                android:textSize="24sp"
                android:textColor="@color/white"
                android:textAlignment="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/header_tab_track_background"
                android:padding="4dp"
                android:layout_marginTop="16dp">

        <TextView
                android:id="@+id/referral_tab_mine"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="My referrals"
                android:fontFamily="@font/poppins_semibold"
                android:includeFontPadding="false"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/referral_tab_selected_background"
                android:textColor="@color/vg_green" />

            <TextView
                android:id="@+id/referral_tab_board"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="Leaderboard"
                android:fontFamily="@font/poppins_semibold"
                android:includeFontPadding="false"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/white" />

            </LinearLayout>

        <EditText
            android:id="@+id/referral_search_mine"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:hint="Search by username or phone number..."
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/rect_box_background"
            android:textSize="13sp"
            android:textColor="@color/vg_dark"
            android:textColorHint="@color/text_muted"
            android:fontFamily="@font/poppins"
            android:imeOptions="actionDone" />

        <EditText
            android:id="@+id/referral_search_board"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:hint="Search by username or phone number..."
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/rect_box_background"
            android:textSize="13sp"
            android:textColor="@color/vg_dark"
            android:textColorHint="@color/text_muted"
            android:fontFamily="@font/poppins"
            android:imeOptions="actionDone"
            android:visibility="gone" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/referral_content_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="88dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ===== MY REFERRALS PANEL ===== -->
                <LinearLayout
                    android:id="@+id/referral_panel_mine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <!-- Code card: title on the left (Number / Username switch on the
                     same line), then ONE row: code, round copy button, Share. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Your referral code"
                            android:gravity="start"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="2dp"
                            android:background="@drawable/referral_switch_track">

                            <TextView
                                android:id="@+id/referral_tab_number"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp"
                                android:text="Number"
                                android:fontFamily="@font/poppins_semibold"
                                android:includeFontPadding="false"
                                android:textSize="12sp"
                                android:textColor="@color/white"
                                android:background="@drawable/referral_switch_selected"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/referral_tab_username"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp"
                                android:text="Username"
                                android:fontFamily="@font/poppins_semibold"
                                android:includeFontPadding="false"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:clickable="true"
                                android:focusable="true" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/referral_code_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:fontFamily="@font/poppins_medium"
                            android:includeFontPadding="false"
                            android:textSize="19sp"
                            android:textColor="@color/vg_dark"
                            android:maxLines="1"
                            android:ellipsize="end"
                            tools:text="0911 032 1143" />

                        <ImageView
                            android:id="@+id/referral_copy_code_btn"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:padding="9dp"
                            android:src="@drawable/ic_copy"
                            android:background="@drawable/icon_button_circle"
                            app:tint="@color/vg_green_dark"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Copy code" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/referral_share_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:minWidth="0dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:fontFamily="@font/poppins_bold"
                            android:includeFontPadding="false"
                            android:text="SHARE"
                            android:textAllCaps="true"
                            android:textSize="13sp"
                            android:textColor="@color/white"
                            android:backgroundTint="@color/vg_green"
                            app:cornerRadius="20dp" />

                    </LinearLayout>

                </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="20dp">

                        <LinearLayout
                            android:id="@+id/referral_breadcrumb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/freq_summary_pill_background"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:layout_marginBottom="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:visibility="gone">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_chevron_left"
                                app:tint="@color/vg_green_dark"
                                android:contentDescription="Back" />
                            <TextView
                                android:id="@+id/referral_breadcrumb_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="13sp"
                                android:fontFamily="@font/poppins_semibold"
                                android:textColor="@color/vg_green_dark"
                                android:gravity="center"
                                android:ellipsize="end"
                                android:maxLines="1" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/referral_recent_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingBottom="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="RECENT REFERRALS"
                                android:textSize="11sp"
                                android:letterSpacing="0.05"
                                android:textColor="@color/text_muted" />
                            <LinearLayout
                                android:id="@+id/referral_total_pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/freq_summary_pill_background"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp"
                                android:visibility="invisible">
                                <TextView
                                    android:id="@+id/referral_total_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:textColor="@color/vg_green_dark" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" Total Referrals"
                                    android:textSize="11sp"
                                    android:textColor="@color/vg_green_dark" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/stats_card_border" />

                        <LinearLayout
                            android:id="@+id/referral_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/referral_list_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="24dp"
                            android:gravity="center"
                            android:textSize="13sp"
                            android:textColor="@color/text_muted"
                            android:text=""
                            android:visibility="gone" />

                        <ProgressBar

                            android:id="@+id/referral_list_spinner"

                            android:layout_width="36dp"

                            android:layout_height="36dp"

                            android:layout_gravity="center_horizontal"

                            android:layout_marginTop="24dp"

                            android:layout_marginBottom="24dp"

                            android:indeterminate="true"

                            android:indeterminateTint="@color/vg_green" />


                <HorizontalScrollView
                    android:id="@+id/referral_pager_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:scrollbars="none"
                    android:visibility="gone">
                    <LinearLayout
                        android:id="@+id/referral_pager"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center" />
                </HorizontalScrollView>

                    </LinearLayout>
                </LinearLayout>

                <!-- ===== LEADERBOARD PANEL ===== -->
                <LinearLayout
                    android:id="@+id/referral_panel_board"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="20dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="8dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start|center_vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="2dp"
                                android:background="@drawable/referral_switch_track">

                            <TextView
                                android:id="@+id/referral_board_tab_number"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:text="Phone number"
                                android:fontFamily="@font/poppins_semibold"
                                android:includeFontPadding="false"
                                android:textSize="11sp"
                                android:textColor="@color/white"
                                android:background="@drawable/referral_switch_selected"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/referral_board_tab_username"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:text="Username"
                                android:fontFamily="@font/poppins_semibold"
                                android:includeFontPadding="false"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:clickable="true"
                                android:focusable="true" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="REFERRALS" android:textSize="11sp" android:letterSpacing="0.05" android:textColor="@color/text_muted" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stats_card_border" />

                    <LinearLayout
                        android:id="@+id/referral_board_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/referral_board_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="24dp"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="@color/text_muted"
                        android:text=""
                            android:visibility="gone" />

                    <ProgressBar

                        android:id="@+id/referral_board_spinner"

                        android:layout_width="36dp"

                        android:layout_height="36dp"

                        android:layout_gravity="center_horizontal"

                        android:layout_marginTop="24dp"

                        android:layout_marginBottom="24dp"

                        android:indeterminate="true"

                        android:indeterminateTint="@color/vg_green" />


                <HorizontalScrollView
                    android:id="@+id/referral_board_pager_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:scrollbars="none"
                    android:visibility="gone">
                    <LinearLayout
                        android:id="@+id/referral_board_pager"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center" />
                </HorizontalScrollView>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include layout="@layout/bottom_nav_bar" />
</FrameLayout>
