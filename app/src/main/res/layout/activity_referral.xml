<?xml version="1.0" encoding="utf-8"?>
<!-- Refer & Earn page. Reached from the "Refer & Earn" button on Home.
     One card with the code and link, three short steps, and a pinned
     Share button. Same green style as Buy Keys, no bottom nav. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vg_green_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/referral_back_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/buy_header_pill"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Back"
                    android:fontFamily="@font/poppins_medium"
                    android:includeFontPadding="false"
                    android:textSize="14sp"
                    android:textColor="@color/vg_green_tint"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Refer &amp; Earn"
                    android:fontFamily="@font/baloo_2_extrabold"
                    android:includeFontPadding="false"
                    android:textSize="30sp"
                    android:textColor="@color/white" />

                <!-- Code + link in one card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:background="@drawable/stats_card_background">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CODE"
                        android:fontFamily="@font/poppins_medium"
                        android:includeFontPadding="false"
                        android:paddingBottom="4dp"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textColor="@color/text_muted" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/referral_code_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/baloo_2_extrabold"
                            android:includeFontPadding="false"
                            android:textSize="22sp"
                            android:textColor="@color/vg_green_dark"
                            android:textIsSelectable="true"
                            android:maxLines="1"
                            tools:text="08012345678" />

                        <TextView
                            android:id="@+id/referral_copy_code_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/badge_verified_background"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="Copy"
                            android:textSize="13sp"
                            android:textColor="@color/vg_green_dark"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="10dp"
                        android:layout_marginEnd="6dp"
                        android:background="@color/card_border" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LINK"
                        android:fontFamily="@font/poppins_medium"
                        android:includeFontPadding="false"
                        android:paddingBottom="4dp"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textColor="@color/text_muted" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/referral_link_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:includeFontPadding="false"
                            android:textSize="12sp"
                            android:textColor="@color/vg_dark"
                            android:textIsSelectable="true"
                            android:paddingTop="2dp"
                            android:paddingEnd="6dp"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/referral_copy_link_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/badge_verified_background"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="Copy link"
                            android:textSize="13sp"
                            android:textColor="@color/vg_green_dark"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Milestones: every 10 referrals = 1 key. Same chip style as the
                     streak milestones on the Repost screen. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/stats_card_background">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="MILESTONES"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:textSize="11sp"
                            android:letterSpacing="0.05"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/referral_to_go"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10 to go"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:textSize="12sp"
                            android:textColor="@color/vg_green_dark"
                            android:background="@drawable/badge_verified_background"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/referral_count_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/baloo_2_extrabold"
                            android:includeFontPadding="false"
                            android:text="-"
                            android:textSize="26sp"
                            android:textColor="@color/vg_green_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="referrals"
                            android:fontFamily="@font/poppins"
                            android:includeFontPadding="false"
                            android:textSize="13sp"
                            android:textColor="@color/text_muted" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/referral_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="8dp"
                        android:max="10"
                        android:progress="0"
                        android:progressDrawable="@drawable/referral_progress" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Counts once your friend's first repost is verified."
                        android:fontFamily="@font/poppins"
                        android:includeFontPadding="false"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <LinearLayout
                            android:id="@+id/referral_chip_10"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stats_card_background"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/baloo_2_extrabold"
                                android:includeFontPadding="false"
                                android:text="10"
                                android:textSize="18sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 KEY"
                                android:fontFamily="@font/poppins_semibold"
                                android:includeFontPadding="false"
                                android:textSize="10sp"
                                android:letterSpacing="0.03"
                                android:textColor="@color/text_muted" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/referral_chip_20"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stats_card_background"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/baloo_2_extrabold"
                                android:includeFontPadding="false"
                                android:text="20"
                                android:textSize="18sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2 KEYS"
                                android:fontFamily="@font/poppins_semibold"
                                android:includeFontPadding="false"
                                android:textSize="10sp"
                                android:letterSpacing="0.03"
                                android:textColor="@color/text_muted" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/referral_chip_30"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stats_card_background"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/baloo_2_extrabold"
                                android:includeFontPadding="false"
                                android:text="30"
                                android:textSize="18sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3 KEYS"
                                android:fontFamily="@font/poppins_semibold"
                                android:includeFontPadding="false"
                                android:textSize="10sp"
                                android:letterSpacing="0.03"
                                android:textColor="@color/text_muted" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/referral_chip_50"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="0dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stats_card_background"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/baloo_2_extrabold"
                                android:includeFontPadding="false"
                                android:text="50"
                                android:textSize="18sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5 KEYS"
                                android:fontFamily="@font/poppins_semibold"
                                android:includeFontPadding="false"
                                android:textSize="10sp"
                                android:letterSpacing="0.03"
                                android:textColor="@color/text_muted" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Three short steps -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/step_number_background"
                            android:fontFamily="@font/baloo_2_bold"
                            android:includeFontPadding="false"
                            android:gravity="center"
                            android:text="1"
                            android:textSize="14sp"
                            android:textColor="@color/vg_green_dark" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="Share your code or link"
                            android:fontFamily="@font/poppins"
                            android:includeFontPadding="false"
                            android:textColor="@color/vg_green_tint"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/step_number_background"
                            android:fontFamily="@font/baloo_2_bold"
                            android:includeFontPadding="false"
                            android:gravity="center"
                            android:text="2"
                            android:textSize="14sp"
                            android:textColor="@color/vg_green_dark" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="Friend enters it at sign up"
                            android:fontFamily="@font/poppins"
                            android:includeFontPadding="false"
                            android:textColor="@color/vg_green_tint"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="0dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/step_number_background"
                            android:fontFamily="@font/baloo_2_bold"
                            android:includeFontPadding="false"
                            android:gravity="center"
                            android:text="3"
                            android:textSize="14sp"
                            android:textColor="@color/vg_green_dark" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="Every 10 referrals, you get a key"
                            android:fontFamily="@font/poppins"
                            android:includeFontPadding="false"
                            android:textColor="@color/vg_green_tint"
                            android:textSize="15sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- Pinned share button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/referral_share_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/baloo_2_bold"
            android:includeFontPadding="false"
            android:text="Share with friends"
            android:letterSpacing="0"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/vg_dark"
            app:cornerRadius="16dp" />

    </LinearLayout>

</FrameLayout>
