<?xml version="1.0" encoding="utf-8"?>
<!-- Refer and earn. A bottom-nav tab screen built exactly like Repost:
     green gradient header with a centered title (no Back arrow, the nav
     pill is the navigation), light background, white bordered cards,
     scroll area with room for the floating nav. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingTop="48dp"
            android:paddingBottom="22dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center">

            <TextView
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Refer and earn"
                android:textSize="24sp"
                android:textColor="@color/white"
                android:textAlignment="center" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/referral_content_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="88dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Referred viewers card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REFERRED VIEWERS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/text_muted" />

                    <TextView
                        android:id="@+id/referral_earnings_text"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="26sp"
                        android:textColor="@color/vg_green_dark" />

                </LinearLayout>

                <!-- Code card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/card_background"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOUR REFERRAL CODE"
                        android:fontFamily="@font/poppins_semibold"
                        android:includeFontPadding="false"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textColor="@color/text_muted" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:padding="3dp"
                        android:background="@drawable/referral_switch_track">

                        <TextView
                            android:id="@+id/referral_tab_number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:paddingTop="9dp"
                            android:paddingBottom="9dp"
                            android:text="Number"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:background="@drawable/referral_switch_selected"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/referral_tab_username"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:paddingTop="9dp"
                            android:paddingBottom="9dp"
                            android:text="Username"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/referral_copy_code_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Copy code">

                        <TextView
                            android:id="@+id/referral_code_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:includeFontPadding="false"
                            android:textSize="26sp"
                            android:textColor="@color/vg_dark"
                            android:maxLines="1"
                            tools:text="0911 032 1143" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="10dp"
                            android:src="@drawable/ic_copy"
                            app:tint="@color/vg_green_dark"
                            android:contentDescription="@null" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/referral_share_btn"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:text="SHARE CODE"
                        android:letterSpacing="0.02"
                        android:textAllCaps="true"
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/vg_green"
                        app:cornerRadius="26dp" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Same loading pattern as Repost: the green header stays and this
             spinner fills the body until the count has loaded. -->
        <LinearLayout
            android:id="@+id/referral_loading_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/vg_green" />

        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/bottom_nav_bar" />
</FrameLayout>
