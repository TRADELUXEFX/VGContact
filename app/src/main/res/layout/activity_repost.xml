<?xml version="1.0" encoding="utf-8"?>
<!--
    Repost screen. Root is a FrameLayout so the bottom nav bar can
    float over the content as a rounded pill (see bottom_nav_bar.xml).
    Header is inline (gradient background, centered bold title) matching
    VGKontact's per-screen header pattern instead of a shared include.

    This screen shows the streak and lets the user log today's repost
    attempt.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingTop="48dp"
            android:paddingBottom="22dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center">

            <TextView
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Repost"
                android:textSize="24sp"
                android:textColor="@color/white"
                android:textAlignment="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Repost daily. Build your streak. Climb the board."
                android:textSize="12sp"
                android:textColor="@color/white"
                android:alpha="0.9"
                android:textAlignment="center"
                android:fontFamily="@font/poppins" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/header_tab_track_background"
                android:padding="4dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/repost_tab_mine"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="My Repost"
                    android:fontFamily="@font/poppins_semibold"
                    android:includeFontPadding="false"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/referral_tab_selected_background"
                    android:textColor="@color/vg_green" />

                <TextView
                    android:id="@+id/repost_tab_board"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:text="Leaderboard"
                    android:fontFamily="@font/poppins_semibold"
                    android:includeFontPadding="false"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:textColor="@color/white" />

            </LinearLayout>

        </LinearLayout>

        <ScrollView
            android:id="@+id/repost_content_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="88dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ===== MY REPOST PANEL ===== -->
                <LinearLayout
                    android:id="@+id/repost_panel_mine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <!-- 3. How it works: its own card, three numbered steps.
                     The X hides the whole card; "Show how it works"
                     below brings it back. -->
                <LinearLayout
                    android:id="@+id/todays_task_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:background="@drawable/card_background"
                    android:padding="18dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:fontFamily="@font/poppins_bold"
                                android:includeFontPadding="false"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/step_number_background"
                                android:gravity="center"
                                android:text="1"
                                android:textSize="14sp"
                                android:textColor="@color/vg_green_dark" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Tap the Repost button"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:fontFamily="@font/poppins_bold"
                                android:includeFontPadding="false"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/step_number_background"
                                android:gravity="center"
                                android:text="2"
                                android:textSize="14sp"
                                android:textColor="@color/vg_green_dark" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Repost the admin's WhatsApp status"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="0dp">

                            <TextView
                                android:fontFamily="@font/poppins_bold"
                                android:includeFontPadding="false"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/step_number_background"
                                android:gravity="center"
                                android:text="3"
                                android:textSize="14sp"
                                android:textColor="@color/vg_green_dark" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Get verified within 24 hours"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/todays_task_close"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_close_small"
                        app:tint="@color/text_muted"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Dismiss how it works" />

                </LinearLayout>

                <TextView
                    android:id="@+id/todays_task_restore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show how it works"
                    android:textColor="@color/vg_green_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@drawable/card_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />

                <!-- Verification status: its own card, shown at the very
                     top (above the Streak card) once the user has
                     reposted today. Icon on the left, text on the right,
                     the pair centered in the card. -->
                <LinearLayout
                    android:id="@+id/repost_status_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/card_background"
                    android:padding="18dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/repost_status_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_pending"
                        app:tint="@color/warning_amber"
                        android:contentDescription="@null" />

                    <TextView
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:id="@+id/repost_status_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Verification pending"
                        android:textSize="18sp"
                        android:textColor="@color/vg_dark" />

                    <!-- Kept (same id) so existing code that sets it keeps
                         working, but never shown. -->
                    <TextView
                        android:id="@+id/repost_status"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Streak card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STREAK"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:fontFamily="@font/poppins_bold"
                            android:includeFontPadding="false"
                            android:id="@+id/streak_days_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 day"
                            android:textSize="26sp"
                            android:textColor="@color/vg_green_dark" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 1. Repost button: stands on its own, not inside any card. -->
                <com.google.android.material.button.MaterialButton
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:textSize="16sp"
                    android:id="@+id/repost_btn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:text="REPOST TODAY"
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    android:backgroundTint="@color/vg_red"
                    android:textColor="@color/white"
                    app:strokeColor="@color/vg_red"
                    app:strokeWidth="2dp"
                    app:cornerRadius="16dp"
                    app:elevation="0dp" />

                <!-- Buy status viewers: one slim outlined button, no big card -->
                <com.google.android.material.button.MaterialButton
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:textSize="16sp"
                    android:id="@+id/buy_viewers_btn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Buy Status Viewers"
                    android:textAllCaps="false"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/vg_green_dark"
                    android:textColor="@color/vg_green_dark"
                    app:icon="@drawable/ic_unlock"
                    app:iconTint="@color/vg_green_dark"
                    app:iconGravity="textStart"
                    app:cornerRadius="16dp" />

                </LinearLayout>

                <!-- ===== LEADERBOARD PANEL ===== -->
                <LinearLayout
                    android:id="@+id/repost_panel_board"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- VGK-style board: one card, column headers, numbered rows -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="8dp">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="start|center_vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:padding="2dp"
                                    android:background="@drawable/referral_switch_track">

                                    <TextView
                                        android:id="@+id/repost_board_tab_number"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingStart="10dp"
                                        android:paddingEnd="10dp"
                                        android:paddingTop="4dp"
                                        android:paddingBottom="4dp"
                                        android:text="Phone number"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:includeFontPadding="false"
                                        android:textSize="11sp"
                                        android:textColor="@color/text_secondary"
                                        android:clickable="true"
                                        android:focusable="true" />
                                    <TextView
                                        android:id="@+id/repost_board_tab_username"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingStart="10dp"
                                        android:paddingEnd="10dp"
                                        android:paddingTop="4dp"
                                        android:paddingBottom="4dp"
                                        android:text="Username"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:includeFontPadding="false"
                                        android:textSize="11sp"
                                        android:textColor="@color/white"
                                        android:background="@drawable/referral_switch_selected"
                                        android:clickable="true"
                                        android:focusable="true" />
                                </LinearLayout>
                            </LinearLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="REPOSTS"
                                android:textSize="11sp"
                                android:letterSpacing="0.05"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/stats_card_border" />

                        <LinearLayout
                            android:id="@+id/board_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />

                        <HorizontalScrollView
                            android:id="@+id/board_pager_scroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:scrollbars="none"
                            android:visibility="gone">
                            <LinearLayout
                                android:id="@+id/board_pager"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center" />
                        </HorizontalScrollView>

                        <TextView
                            android:id="@+id/board_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="24dp"
                            android:gravity="center"
                            android:textSize="13sp"
                            android:textColor="@color/text_muted"
                            android:text=""
                            android:visibility="gone" />

                        <ProgressBar

                            android:id="@+id/repost_board_spinner"

                            android:layout_width="36dp"

                            android:layout_height="36dp"

                            android:layout_gravity="center_horizontal"

                            android:layout_marginTop="24dp"

                            android:layout_marginBottom="24dp"

                            android:indeterminate="true"

                            android:indeterminateTint="@color/vg_green" />


                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>


        <!-- Same loading pattern as Get Viewers: the green header above
             stays visible and this spinner fills the body area under it
             until the screen's data has loaded. -->
        <LinearLayout
            android:id="@+id/repost_loading_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/vg_green" />

        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/bottom_nav_bar" />
</FrameLayout>
