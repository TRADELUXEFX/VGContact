<?xml version="1.0" encoding="utf-8"?>
<!--
    Key-earning screen. Root is a FrameLayout so the bottom nav bar can
    float over the content as a rounded pill (see bottom_nav_bar.xml).
    Header is inline (gradient background, centered bold title) matching
    VGKontact's per-screen header pattern instead of a shared include.

    Keys are the app's unlock currency (see RepostActivity.kt /
    vgcontact_keys_schema.sql) - this screen shows the current balance,
    lets the user log today's repost attempt, and offers a way to buy
    more keys directly.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingTop="72dp"
            android:paddingBottom="28dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Repost"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textAlignment="center" />

            <!-- My streak / Leaderboard tab switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:background="@drawable/header_tab_track_background"
                android:padding="4dp">

                <TextView
                    android:id="@+id/repost_tab_streak"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="My streak"
                    android:textAlignment="center"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:padding="10dp"
                    android:background="@drawable/tab_selected_background"
                    android:textColor="@color/vg_green_dark"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/repost_tab_leaderboard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Leaderboard"
                    android:textAlignment="center"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:padding="10dp"
                    android:textColor="@color/white"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

        <ScrollView
            android:id="@+id/repost_content_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="88dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Two stat cards side by side: keys + streak -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="16dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YOUR KEYS"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/key_balance_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_green_dark" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="16dp"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STREAK"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/streak_days_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 day"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_green_dark" />

                    </LinearLayout>

                </LinearLayout>

                <!-- One action card: status + button + instructions together.
                     The verification status lives INSIDE this card (same ids
                     as before) so it is always right next to the button. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="18dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TODAY"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:textColor="@color/text_muted" />



                    </LinearLayout>

                    <!-- Verification status (hidden until the user has reposted today) -->
                    <LinearLayout
                        android:id="@+id/repost_status_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/repost_status_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_pending"
                            app:tint="@color/warning_amber"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/repost_status_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Verification pending"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/vg_dark" />

                            <TextView
                                android:id="@+id/repost_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="We check reposts each night."
                                android:textColor="@color/text_muted"
                                android:textSize="13sp" />

                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/repost_btn"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="REPOSTED TODAY"
                        android:textAllCaps="true"
                        android:letterSpacing="0.02"
                        android:textStyle="bold"
                        android:backgroundTint="@color/vg_green_tint"
                        android:textColor="@color/vg_green_dark"
                        app:cornerRadius="14dp"
                        app:elevation="0dp"
                        app:rippleColor="@color/vg_green" />

                    <!-- Dismissible how-it-works tip. Only this row hides when the X
                         is tapped; the status and Repost button above it never do. -->
                    <LinearLayout
                        android:id="@+id/todays_task_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tap Repost, repost admin's WhatsApp status, then come back. Your key is added once approved."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.3" />

                        <ImageView
                            android:id="@+id/todays_task_close"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="10dp"
                            android:src="@drawable/ic_close_small"
                            app:tint="@color/text_muted"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Dismiss today's task tip" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/todays_task_restore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show how it works"
                    android:textColor="@color/vg_green_dark"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />

                <!-- Milestones: same chips as before, tighter card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="MILESTONES"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/milestone_days_to_go"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 days to go"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_green_dark"
                            android:background="@drawable/badge_verified_background"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <LinearLayout
                            android:id="@+id/milestone_3day"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/freq_tile_selected_background"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/vg_green_dark" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DAYS"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.03"
                                android:textColor="@color/vg_green_dark" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stats_card_background"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="7"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DAYS"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.03"
                                android:textColor="@color/text_muted" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stats_card_background"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="14"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DAYS"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.03"
                                android:textColor="@color/text_muted" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stats_card_background"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DAYS"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.03"
                                android:textColor="@color/text_muted" />

                        </LinearLayout>

                    </LinearLayout>


                </LinearLayout>

                <!-- Buy keys: one slim outlined button, no big card -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buy_keys_btn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Need keys faster? Buy keys"
                    android:textAllCaps="false"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/vg_green_dark"
                    android:textColor="@color/vg_green_dark"
                    app:icon="@drawable/ic_unlock"
                    app:iconTint="@color/vg_green_dark"
                    app:iconGravity="textStart"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </ScrollView>

        <!-- Shown until both the key balance and today's repost status
             have finished loading, so the screen never briefly shows
             stale defaults (0 keys, enabled button, no status card)
             before the real data arrives. -->
        <LinearLayout
            android:id="@+id/repost_loading_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/vg_green" />

        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/bottom_nav_bar" />
</FrameLayout>
