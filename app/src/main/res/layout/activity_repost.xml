<?xml version="1.0" encoding="utf-8"?>
<!--
    Key-earning screen. Root is a FrameLayout so the bottom nav bar can
    float over the content as a rounded pill (see bottom_nav_bar.xml).
    Header is inline (gradient background, centered bold title) matching
    VGKontact's per-screen header pattern instead of a shared include.

    Keys are the app's unlock currency (see RepostActivity.kt /
    vgcontact_keys_schema.sql) - this screen shows the current balance,
    lets the user log today's repost attempt, and offers a way to buy
    more keys directly.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingTop="48dp"
            android:paddingBottom="28dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Repost &amp; Earn"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textAlignment="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Repost daily. Build your streak. Climb the board."
                android:textSize="12sp"
                android:alpha="0.9"
                android:textColor="@color/white"
                android:textAlignment="center" />

            <!-- My streak / Leaderboard tab switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:background="@drawable/tab_track_background"
                android:padding="4dp">

                <TextView
                    android:id="@+id/repost_tab_streak"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="My streak"
                    android:textAlignment="center"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:padding="10dp"
                    android:background="@drawable/tab_selected_background"
                    android:textColor="@color/vg_green_dark"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/repost_tab_leaderboard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Leaderboard"
                    android:textAlignment="center"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:padding="10dp"
                    android:textColor="@color/white"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="88dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 7-day streak row: S M T W T F S dots, filled/checked up to today -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:weightSum="7">

                    <ImageView
                        android:id="@+id/streak_dot_0"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:src="@drawable/streak_dot_inactive"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/streak_dot_1"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:src="@drawable/streak_dot_inactive"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/streak_dot_2"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:src="@drawable/streak_dot_inactive"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/streak_dot_3"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:src="@drawable/streak_dot_inactive"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/streak_dot_4"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:src="@drawable/streak_dot_inactive"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/streak_dot_5"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:src="@drawable/streak_dot_inactive"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/streak_dot_6"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:src="@drawable/streak_dot_check"
                        android:contentDescription="@null" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:weightSum="7">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S" android:textAlignment="center" android:textSize="11sp" android:textColor="@color/text_muted" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="M" android:textAlignment="center" android:textSize="11sp" android:textColor="@color/text_muted" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="T" android:textAlignment="center" android:textSize="11sp" android:textColor="@color/text_muted" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="W" android:textAlignment="center" android:textSize="11sp" android:textColor="@color/text_muted" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="T" android:textAlignment="center" android:textSize="11sp" android:textColor="@color/text_muted" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="F" android:textAlignment="center" android:textSize="11sp" android:textColor="@color/text_muted" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S" android:textAlignment="center" android:textSize="11sp" android:textColor="@color/text_muted" />

                </LinearLayout>

                <!-- Compact keys readout: label left, balance right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_background"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_unlock"
                        app:tint="@color/vg_green_dark"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Your Keys"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/vg_dark" />

                    <TextView
                        android:id="@+id/key_balance_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/vg_green_dark" />

                </LinearLayout>

                <!-- Tip guide: explains the whole flow up front. Dismissible; -->
                <!-- reopened via the dashed restore chip below it. -->
                <LinearLayout
                    android:id="@+id/repost_guide_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/card_background"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="1dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/vg_green_dark"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Tap Repost Today to share VGContact on your WhatsApp status. One verified repost a day earns you 1 key. After you repost, come back here — you'll see a pending badge while it's checked, then your key balance updates once it's approved."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3" />

                    <ImageView
                        android:id="@+id/repost_guide_close"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_close_small"
                        app:tint="@color/text_muted"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Dismiss tip" />

                </LinearLayout>

                <TextView
                    android:id="@+id/repost_guide_restore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/repost_guide_toggle_background"
                    android:padding="12dp"
                    android:text="Show the repost tip again"
                    android:textAlignment="center"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/vg_green_dark"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Today's Task: daily repost flow, matching the streak-card design -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TODAY'S TASK"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/text_muted"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Tap the button below to open admin's WhatsApp."
                        android:textColor="@color/vg_dark"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.35"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2. View today's status and tap Repost on it. No need to create anything."
                        android:textColor="@color/vg_dark"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.35"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3. Send the prefilled message so we can count it."
                        android:textColor="@color/vg_dark"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.35"
                        android:layout_marginBottom="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/repost_btn"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="REPOSTED TODAY"
                        android:textAllCaps="true"
                        android:letterSpacing="0.02"
                        android:textStyle="bold"
                        android:backgroundTint="@color/vg_green_tint"
                        android:textColor="@color/vg_green_dark"
                        app:cornerRadius="14dp"
                        app:elevation="0dp"
                        app:rippleColor="@color/vg_green" />

                </LinearLayout>

                <!-- Milestones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="MILESTONES"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/milestone_days_to_go"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 days to go"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_green_dark"
                            android:background="@drawable/badge_verified_background"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/milestone_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginBottom="16dp"
                        android:max="100"
                        android:progress="35"
                        android:progressDrawable="@drawable/milestone_progress_bar" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <LinearLayout
                            android:id="@+id/milestone_3day"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/freq_tile_selected_background"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/vg_green_dark" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DAYS"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.03"
                                android:textColor="@color/vg_green_dark" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stats_card_background"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="7"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DAYS"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.03"
                                android:textColor="@color/text_muted" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stats_card_background"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="14"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DAYS"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.03"
                                android:textColor="@color/text_muted" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stats_card_background"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DAYS"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.03"
                                android:textColor="@color/text_muted" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Verification status panel: its own card, shown only once -->
                <!-- the user has reposted today, so it reads as a distinct -->
                <!-- pending/approved "screen" rather than a small text line. -->
                <LinearLayout
                    android:id="@+id/repost_status_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_background"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/repost_status_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_pending"
                        app:tint="@color/warning_amber"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/repost_status_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Verification pending"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/vg_dark" />

                        <TextView
                            android:id="@+id/repost_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Repost once a day to earn a key. Verified reposts add a key to your balance the next day."
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Buy keys directly -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Need Keys Faster?"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/vg_dark"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Buy keys directly to unlock files right away."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buy_keys_btn"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Buy Keys"
                        android:textAllCaps="false"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:strokeColor="@color/vg_green_dark"
                        android:textColor="@color/vg_green_dark"
                        app:icon="@drawable/ic_unlock"
                        app:iconTint="@color/vg_green_dark"
                        app:iconGravity="textStart"
                        app:cornerRadius="16dp" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include layout="@layout/bottom_nav_bar" />
</FrameLayout>
