<?xml version="1.0" encoding="utf-8"?>
<!--
    Root is a FrameLayout so the bottom nav bar can float over the
    content as a rounded pill (see bottom_nav_bar.xml). Header is
    inline (gradient background, centered bold title) matching
    VGKontact's per-screen header pattern instead of a shared include.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingTop="48dp"
            android:paddingBottom="28dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Repost"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textAlignment="center" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="88dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Share VGContact on WhatsApp to unlock a bonus code."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/repost_btn"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Repost on WhatsApp"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/vg_green"
                        android:textColor="@color/white"
                        app:icon="@drawable/ic_link"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart"
                        app:cornerRadius="16dp"
                        android:layout_marginBottom="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/repost_status_icon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_pending"
                            app:tint="@color/text_muted"
                            android:layout_marginEnd="6dp"
                            android:layout_gravity="top"
                            android:contentDescription="@null" />
                        <TextView
                            android:id="@+id/repost_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tap the button above, send the message in WhatsApp, then come back here"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/unlocked_code_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/code_pill_background"
                    android:padding="20dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/unlocked_code_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_clipboard"
                        app:tint="@color/success_text"
                        app:layout_constraintTop_toTopOf="@id/unlocked_code_text"
                        app:layout_constraintBottom_toBottomOf="@id/unlocked_code_text"
                        app:layout_constraintStart_toStartOf="parent"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/unlocked_code_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/success_text"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/unlocked_code_icon"
                        android:layout_marginStart="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/copy_code_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="Copy Code"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/vg_green"
                        android:textColor="@color/white"
                        app:icon="@drawable/ic_clipboard"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart"
                        app:cornerRadius="12dp"
                        app:layout_constraintTop_toBottomOf="@id/unlocked_code_text"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginTop="14dp" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include layout="@layout/bottom_nav_bar" />
</FrameLayout>
