<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/vg_green">
            <TextView
                android:id="@+id/header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:paddingStart="16dp" />
        </FrameLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share VGContact on WhatsApp to unlock a bonus code."
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/repost_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="Repost on WhatsApp"
                    android:backgroundTint="@color/vg_green"
                    android:textColor="@color/white"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/repost_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:layout_marginBottom="16dp" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/unlocked_code_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/success_bg"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/unlocked_code_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/success_text"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <Button
                        android:id="@+id/copy_code_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Copy Code"
                        android:backgroundTint="@color/vg_green"
                        android:textColor="@color/white"
                        app:layout_constraintTop_toBottomOf="@id/unlocked_code_text"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginTop="12dp" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </ScrollView>
        <ImageButton
            android:id="@+id/chat_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@color/vg_green"
            android:src="@drawable/ic_chat"
            app:tint="@color/white"
            android:padding="12dp"
            android:contentDescription="Chat support" />
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/vg_dark"
            app:menu="@menu/bottom_nav_menu" />
    </LinearLayout>
</FrameLayout>
