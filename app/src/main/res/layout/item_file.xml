<?xml version="1.0" encoding="utf-8"?>
<!--
    Compact row: small file icon, name + status dot on one line, and a
    single circular action button on the right (download when unlocked,
    lock when locked). Replaces the old stacked title/subtitle/pill/
    full-width-button card so more rows fit on screen and status reads
    at a glance via the dot color instead of a separate pill.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/card_background"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/file_row_icon_background"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/file_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_unlock"
            app:tint="@color/vg_green_dark"
            android:contentDescription="@null" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:fontFamily="@font/baloo_2_bold"
            android:includeFontPadding="false"
            android:id="@+id/file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15.5sp"
            android:textColor="@color/vg_dark"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <View
                android:id="@+id/file_status_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/status_dot_unlocked" />

            <TextView
                android:id="@+id/file_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11.5sp"
                android:textColor="@color/text_muted" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/download_btn"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/file_row_action_background"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/download_btn_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_download"
            app:tint="@color/white"
            android:contentDescription="@null" />

    </FrameLayout>

</LinearLayout>
