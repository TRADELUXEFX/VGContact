<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Whole screen scrolls: on small phones or large font sizes nothing is squeezed
         or hidden between the header and the buttons. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- RED HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/header_gradient_red"
            android:paddingTop="56dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="32dp">

            <TextView
                android:textAppearance="@style/TextAppearance.VG.Lead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your account has been"
                android:alpha="0.92"
                android:gravity="center"
                android:textColor="@color/white" />

            <TextView
                android:textAppearance="@style/TextAppearance.VG.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Banned"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- WHITE BODY -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
            android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ill_banned" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background">

                    <!-- ACCOUNT -->
                    <LinearLayout
                        android:id="@+id/bannedAccountSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <TextView
                            android:textAppearance="@style/TextAppearance.VG.MicroSemibold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACCOUNT"
                            android:letterSpacing="0.1"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:textAppearance="@style/TextAppearance.VG.Subheading"
                            android:id="@+id/bannedNumberText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/vg_dark" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stats_card_border" />

                    <!-- REASON -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:textAppearance="@style/TextAppearance.VG.MicroSemibold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="REASON"
                            android:letterSpacing="0.1"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:textAppearance="@style/TextAppearance.VG.Heading"
                            android:id="@+id/bannedReasonText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Breaking the app's rules"
                            android:textColor="@color/vg_red" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stats_card_border" />

                    <!-- WHAT THIS MEANS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="18dp">

                        <TextView
                            android:textAppearance="@style/TextAppearance.VG.MicroSemibold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WHAT THIS MEANS"
                            android:letterSpacing="0.1"
                            android:textColor="@color/text_muted" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="14dp">

                            <TextView
                                android:textAppearance="@style/TextAppearance.VG.MicroSemibold"
                                android:layout_width="wrap_content"
        android:minWidth="26dp"
                                android:layout_height="wrap_content"
        android:minHeight="26dp"
                                android:background="@drawable/dialog_warning_icon_background"
                                android:gravity="center"
                                android:text="✕"
                                android:textColor="@color/vg_red" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">

                                <TextView
                                    android:textAppearance="@style/TextAppearance.VG.Subheading"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="No keys, unlocks or reposts"
                                    android:textColor="@color/vg_dark" />

                                <TextView
                                    android:textAppearance="@style/TextAppearance.VG.BodySmall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:text="You can't earn keys, unlock contact groups or repost while banned."
                                    android:textColor="@color/text_muted" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:textAppearance="@style/TextAppearance.VG.BodySmallSemibold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Opening a new account with the same number or phone won't get around this."
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

        <!-- ACTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <Button
                android:textAppearance="@style/TextAppearance.VG.Button"
                android:id="@+id/contactCareButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
        android:minHeight="56dp"
                android:text="Contact customer care"
                android:includeFontPadding="false"
                android:textAllCaps="false"
                android:backgroundTint="@color/vg_green"
                android:textColor="@color/white"
                android:gravity="center"
                app:cornerRadius="16dp" />

            <TextView
                android:textAppearance="@style/TextAppearance.VG.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Contact us if you think we're wrong"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/text_muted" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>

</FrameLayout>
