<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/pending_sheet_background"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/pending_sheet_handle" />

    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/pending_sheet_icon_background">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_repost"
            app:tint="@color/warning_amber"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:fontFamily="@font/poppins_bold"
        android:includeFontPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Repost to get seen"
        android:textSize="18sp"
        android:textColor="@color/vg_dark" />

    <TextView
        android:fontFamily="@font/poppins"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Repost the admin's status and your contacts can start seeing yours. We verify it for you."
        android:textSize="14sp"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pendingSheetRepostBtn"
        android:fontFamily="@font/poppins_bold"
        android:includeFontPadding="false"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="22dp"
        android:text="Repost now"
        android:textAllCaps="true"
        android:textSize="16sp"
        android:letterSpacing="0.02"
        android:textColor="@color/white"
        android:backgroundTint="@color/warning_amber"
        app:icon="@drawable/ic_repost"
        app:iconTint="@color/white"
        app:iconGravity="textStart"
        app:cornerRadius="16dp" />

    <TextView
        android:id="@+id/pendingSheetLaterBtn"
        android:fontFamily="@font/poppins_bold"
        android:includeFontPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="12dp"
        android:text="Later"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
