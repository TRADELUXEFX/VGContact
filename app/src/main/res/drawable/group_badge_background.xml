<?xml version="1.0" encoding="utf-8"?>
<!-- Sits on the green header (see header_gradient.xml), so it uses the
     same translucent-white-on-green treatment as
     header_tab_track_background.xml and notification_circle_background.xml
     instead of a solid light fill, which read as a near-white box against
     the green. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#33FFFFFF" />

    <stroke
        android:width="1dp"
        android:color="#4DFFFFFF" />

    <corners android:radius="20dp" />

</shape>
