<?xml version="1.0" encoding="utf-8"?>
<!-- White card with a crisp 4dp strip peeking out underneath, the same idea as
     btn_primary_shadow under the Post button (no blurry elevation shadow).
     A view using this background needs 4dp more bottom padding than usual. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pending_card_lift" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="1dp" android:color="@color/stats_card_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
