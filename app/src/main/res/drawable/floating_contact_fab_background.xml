<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded-square background for the app-wide floating Contact Us
     button (FloatingContactHelper). Same soft-square shape as WhatsApp's
     hovering new-chat button, in the brand green with a darker ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/vg_green_dark">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vg_green" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
