<?xml version="1.0" encoding="utf-8"?>
<!-- Main-screen header (Home, Repost, Referral, Profile): same green
     gradient as header_gradient.xml, with the bottom corners rounded
     40dp like the VG RESHARE header. Other screens keep header_gradient. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/vg_green"
        android:endColor="@color/vg_green_dark" />
    <corners
        android:bottomLeftRadius="40dp"
        android:bottomRightRadius="40dp" />
</shape>
