<?xml version="1.0" encoding="utf-8"?>
<!-- Soft "lifted" base under the primary Repost button. A slightly darker
     green strip peeks out under the button, which reads as depth without
     needing API-specific elevation shadows. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/vg_green_dark" />
    <corners android:radius="18dp" />
</shape>
