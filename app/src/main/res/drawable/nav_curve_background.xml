<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom bar for the main screens: full width green gradient with the
     top corners rounded 22dp, like the VG RESHARE bottom bar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@color/vg_green"
        android:endColor="@color/vg_green_dark" />
    <corners
        android:topLeftRadius="22dp"
        android:topRightRadius="22dp" />
</shape>
