<?xml version="1.0" encoding="utf-8"?>
<!-- Red header for the Banned screen, with the same 40dp curved bottom
     corners as header_gradient_curve. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/vg_red"
        android:endColor="@color/vg_red_dark" />
    <corners
        android:bottomLeftRadius="40dp"
        android:bottomRightRadius="40dp" />
</shape>
