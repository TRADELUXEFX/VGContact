<?xml version="1.0" encoding="utf-8"?>
<!-- Repost button background: solid green while today's repost is still to
     do; turns WHITE (with a green outline, green text and green check - see
     repost_btn_text.xml and the strokeColor in activity_repost.xml) once
     today's repost has been logged. The button stays enabled either way. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:color="@color/white" />
    <item android:color="@color/vg_green" />
</selector>
