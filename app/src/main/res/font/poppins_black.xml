<?xml version="1.0" encoding="utf-8"?>
<!-- Poppins Black: official static font files (SIL OFL). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/poppins_black_bundled"
        android:fontStyle="normal"
        android:fontWeight="900"
        app:font="@font/poppins_black_bundled"
        app:fontStyle="normal"
        app:fontWeight="900" />
    <font
        android:font="@font/poppins_black_italic_bundled"
        android:fontStyle="italic"
        android:fontWeight="900"
        app:font="@font/poppins_black_italic_bundled"
        app:fontStyle="italic"
        app:fontWeight="900" />
</font-family>
