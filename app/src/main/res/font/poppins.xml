<?xml version="1.0" encoding="utf-8"?>
<!-- Body text. textStyle="bold" maps to Poppins Medium (middle ground, not full Bold). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/poppins_regular_bundled"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/poppins_regular_bundled"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/poppins_medium_bundled"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/poppins_medium_bundled"
        app:fontStyle="normal"
        app:fontWeight="600" />
</font-family>
