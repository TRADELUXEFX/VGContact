<?xml version="1.0" encoding="utf-8"?>
<!-- Poppins Medium: official static font files (SIL OFL). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/poppins_medium_bundled"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/poppins_medium_bundled"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/poppins_medium_italic_bundled"
        android:fontStyle="italic"
        android:fontWeight="500"
        app:font="@font/poppins_medium_italic_bundled"
        app:fontStyle="italic"
        app:fontWeight="500" />
</font-family>
