<?xml version="1.0" encoding="utf-8"?>
<!-- Poppins Bold: official static font files (SIL OFL). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/poppins_bold_bundled"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/poppins_bold_bundled"
        app:fontStyle="normal"
        app:fontWeight="700" />
    <font
        android:font="@font/poppins_bold_italic_bundled"
        android:fontStyle="italic"
        android:fontWeight="700"
        app:font="@font/poppins_bold_italic_bundled"
        app:fontStyle="italic"
        app:fontWeight="700" />
</font-family>
