<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded pop-up used by the Get Viewers screen: green header with an icon
     beside the title, message, optional "4 -> 3 keys left" row, 2 buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_popup_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="22dp"
        android:paddingBottom="22dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/dialog_popup_header_background">

        <ImageView
            android:id="@+id/popup_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_unlock"
            app:tint="@color/white"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/popup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false"
            android:textSize="20sp"
            android:textColor="@color/white" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="20dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/popup_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:id="@+id/popup_balance_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical|center_horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/popup_balance_from"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:textSize="30sp"
                android:textColor="@color/vg_green_dark" />

            <ImageView
                android:id="@+id/popup_balance_arrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_muted"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/popup_balance_to"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:textSize="30sp"
                android:textColor="@color/vg_green_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="keys left"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/popup_negative"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:textAllCaps="true"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1.5dp"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/popup_positive"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.3"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:textAllCaps="true"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/vg_green"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
